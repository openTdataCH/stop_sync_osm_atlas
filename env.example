# Copy this file to .env and adjust values. Do not commit your .env.

# SQLAlchemy URIs (override if you change users/passwords/hosts)
DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/import_db

# Flask & Security
FLASK_DEBUG=1
FORCE_HTTPS=false

# Rate Limiting (memory:// is the local default; use Redis for multi-worker deployments)
RATELIMIT_STORAGE_URI=memory://

# Shared runtime state for pipeline status/locks and async exports.
# STATE_BACKEND can be redis or file.
STATE_BACKEND=redis
STATE_REDIS_URL=redis://redis:6379/0
STATE_DIR=data/runtime

# Dev toggles

# Scheduler
PIPELINE_TIMEZONE=Europe/Zurich
PIPELINE_SCHEDULE_INTERVAL_HOURS=24
PIPELINE_IMPORT_ETA_SECONDS=150
PIPELINE_LOG_LEVEL=INFO
