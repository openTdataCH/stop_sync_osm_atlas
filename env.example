# Copy this file to .env and adjust values. Do not commit your .env.

# SQLAlchemy URIs (override if you change users/passwords/hosts)
DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/stops_db
AUTH_DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/auth_db

# Flask
SECRET_KEY=dev-insecure
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false

# Encryption key for TOTP secrets (Fernet 32-byte urlsafe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_SECRET_ENC_KEY=

# Dev toggles
AUTO_MIGRATE=true
MATCH_ONLY=false
SKIP_DATA_IMPORT=false

# Optional Turnstile keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Email / Amazon SES
# Region where your SES is configured (e.g., eu-west-1)
AWS_REGION=eu-west-1
# Verified SES identity used as the From address (required)
SES_FROM_EMAIL=
# Optional: existing SES configuration set name
SES_CONFIGURATION_SET=

# AWS credentials for SES (only if not using instance/task roles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= # optional for temporary credentials

