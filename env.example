# Copy this file to .env and adjust values. Do not commit your .env.

# SQLAlchemy URIs (override if you change users/passwords/hosts)
DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/import_db
# Bound web requests before Gunicorn's worker timeout.
WEB_DB_CONNECT_TIMEOUT_SECONDS=5
WEB_DB_LOCK_TIMEOUT_MS=3000
WEB_DB_STATEMENT_TIMEOUT_MS=25000

# Flask & Security
FLASK_DEBUG=1
FORCE_HTTPS=false

# Rate limiting (memory:// is the default)
RATELIMIT_STORAGE_URI=memory://

# Shared JSON-file runtime state for pipeline status/locks and async exports.
STATE_BACKEND=file
STATE_DIR=data/runtime

# Dev toggles

# Standalone matching-engine checkout. Keep ENGINE_REPO and ENGINE_REF in your
# uncommitted .env when testing a private repository; Docker builds use the
# verified local checkout rather than receiving GitHub credentials.
# scripts/verify_engine_checkout.sh requires both values. Pin the full commit
# SHA of the reviewed release: git -C ../engine rev-list -n 1 v0.1.1
ENGINE_REPO=https://github.com/your-account/matching-engine.git
ENGINE_DIR=../engine
ENGINE_REF=<full-commit-sha>

# Scheduler
PIPELINE_TIMEZONE=Europe/Zurich
PIPELINE_SCHEDULE_INTERVAL_HOURS=24
PIPELINE_IMPORT_ETA_SECONDS=150
PIPELINE_LOG_LEVEL=INFO
# Long lease prevents overlap; owner identity and heartbeat freshness let the
# watchdog recover a dead runner without waiting for the full lease to expire.
PIPELINE_LOCK_TTL_SECONDS=14400
PIPELINE_LOCK_HEARTBEAT_SECONDS=60
PIPELINE_LOCK_STALE_SECONDS=135
PIPELINE_WATCHDOG_INTERVAL_SECONDS=60

# Review UI profile and independent engine executable (scheduler only)
REVIEW_CONFIG=config/switzerland.json
MATCHER_COMMAND=public-transport-matcher
PIPELINE_WORKSPACE=/app
PIPELINE_BUNDLE_DIR=data/results
# Ignore validators and regenerate acquisition products on the next full run.
PIPELINE_FORCE_FULL_REFRESH=false

# Pipeline performance. GTFS_*: engine/documentation/5.2 Pipeline Performance.md;
# DB_IMPORT_*: documentation/1.1 Import Process.md
GTFS_PROCESSING_BACKEND=duckdb
GTFS_THREADS=2
GTFS_MEMORY_LIMIT=1536MB
DB_IMPORT_METHOD=copy
DB_IMPORT_BATCH_SIZE=10000

# Documentation portal. Engine source files are linked only when this public
# base URL is set, e.g. https://github.com/<owner>/<engine>/blob/<commit>/
# DOCS_ENGINE_BLOB_BASE=
