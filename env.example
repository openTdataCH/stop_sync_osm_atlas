# Copy this file to .env and adjust values. Do not commit your .env.

# SQLAlchemy URIs (override if you change users/passwords/hosts)
DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/import_db
USER_INPUT_DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/user_input_db

# Flask
SECRET_KEY=dev-insecure
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false

# Encryption key for TOTP secrets (Fernet 32-byte urlsafe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_SECRET_ENC_KEY=

# Dev toggles
# Migrations are handled by the dedicated `migrator` service by default.
AUTO_MIGRATE=false
RUN_STARTUP_PIPELINE=false

# Scheduler
PIPELINE_TIMEZONE=Europe/Zurich
PIPELINE_SCHEDULE_HOUR=2
PIPELINE_SCHEDULE_MINUTE=0
PIPELINE_IMPORT_ETA_SECONDS=280


