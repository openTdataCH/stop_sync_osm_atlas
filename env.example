# Settings for the Docker Compose setup: copy this file to .env and change what you need. Do not commit .env.
# Every setting has a default in the code, so .env holds only what you change. All settings are listed in
# documentation/3. Application architecture & deployment.md, section "Settings". A server without Docker
# sets them in the environment of its services instead; it does not read .env.

# The engine checkout that Docker builds from and the documentation portal shows. It must be at the commit
# pinned in engine.ref; scripts/verify_engine_checkout.sh checks it.
ENGINE_DIR=../engine

# 1 runs Flask's debug server, 0 runs Gunicorn. Compose's default is 1.
FLASK_DEBUG=1

# Compose's default is its db container, with a placeholder password.
# DATABASE_URI=postgresql+psycopg://stops_user:1234@db:5432/import_db

# Examples of other settings:
# REVIEW_CONFIG=config/gtfs-example.json   # a review configuration without Swiss specifics
# PIPELINE_SCHEDULE_INTERVAL_HOURS=24      # hours between scheduled runs (default 1)
# PIPELINE_FORCE_FULL_REFRESH=true         # rebuild every cached source on the next full run
