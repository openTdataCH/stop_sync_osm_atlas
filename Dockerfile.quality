# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS node
FROM python:3.13-slim-bookworm
COPY --from=node /usr/local /opt/node
ENV PATH="/opt/node/bin:${PATH}" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    git make libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/app
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt
COPY package.json package-lock.json ./
RUN npm ci
# Engine dependencies live in a separate interpreter: app tests cannot import it.
COPY --from=engine /pyproject.toml /README.md /LICENSE /opt/engine/
COPY --from=engine /src /opt/engine/src
RUN python -m venv /opt/engine-venv \
    && /opt/engine-venv/bin/pip install --no-cache-dir '/opt/engine[swiss,gtfs,quality]'
CMD ["python", "scripts/run_quality.py", "full", "--engine-dir", "/workspace/engine", "--engine-python", "/opt/engine-venv/bin/python"]
