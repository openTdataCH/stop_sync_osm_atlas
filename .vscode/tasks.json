{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Web app & DB",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/run_vscode_task.sh", "${input:webAppAction}"],
			"problemMatcher": [],
			"group": "build",
			"presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": true, "clear": false }
		},
		{
			"label": "Data pipeline & matching",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/run_vscode_task.sh", "${input:dataPipelineAction}"],
			"problemMatcher": [],
			"group": "build",
			"presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": true, "clear": false }
		},
		{
			"label": "Tests",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/run_vscode_task.sh", "${input:testAction}"],
			"problemMatcher": [],
			"group": { "kind": "test", "isDefault": true },
			"presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": true, "clear": false }
		},
		{
			"label": "Docs",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/run_vscode_task.sh", "${input:docsAction}"],
			"problemMatcher": [],
			"group": "build",
			"presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": true, "clear": false }
		},
		{
			"label": "Sync vendor libraries",
			"type": "shell",
			"command": "bash",
			"args": ["${workspaceFolder}/scripts/run_vscode_task.sh", "${input:vendorSyncAction}"],
			"problemMatcher": [],
			"group": "build",
			"presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": true, "clear": false }
		}
	],
	"inputs": [
		{
			"id": "webAppAction",
			"type": "pickString",
			"description": "Choose a web application or database action",
			"options": [
				{ "label": "Start app (debug)", "value": "web-debug" },
				{ "label": "Start app (Gunicorn)", "value": "web-gunicorn" },
				{ "label": "Run DB upgrade", "value": "web-db-upgrade" },
				{ "label": "Regenerate dashboard stats", "value": "web-regenerate-stats" }
			]
		},
		{
			"id": "dataPipelineAction",
			"type": "pickString",
			"description": "Choose a pipeline or matching action",
			"options": [
				{ "label": "Match and import existing data", "value": "pipeline-existing-data" },
				{ "label": "Run full pipeline (download, match, import)", "value": "pipeline-full" },
				{ "label": "Run full pipeline (force full refresh)", "value": "pipeline-force-refresh" },
				{ "label": "Trigger scheduled pipeline now", "value": "pipeline-scheduled-now" }
			]
		},
		{
			"id": "testAction",
			"type": "pickString",
			"description": "Choose the test suite",
			"options": [
				{ "label": "Run all tests", "value": "test-all" },
				{ "label": "Validate result contract", "value": "test-result-contract" }
			]
		},
		{
			"id": "docsAction",
			"type": "pickString",
			"description": "Choose a documentation action",
			"options": [
				{ "label": "Build PDF", "value": "docs-pdf" },
				{ "label": "Generate ER diagram", "value": "docs-er-diagram" }
			]
		},
		{
			"id": "vendorSyncAction",
			"type": "pickString",
			"description": "Confirm the vendor-library action",
			"options": [
				{ "label": "Sync local vendor libraries", "value": "sync-vendor-libraries" }
			]
		}
	]
}
