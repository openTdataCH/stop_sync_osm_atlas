{
  "name": "stop-sync-osm-atlas",
  "version": "1.0.0",
  "description": "Frontend tests for Stop Sync OSM Atlas",
  "private": true,
  "scripts": {
    "docs:render-mermaid": "node scripts/render_docs_mermaid.mjs",
    "docs:check-mermaid": "node scripts/render_docs_mermaid.mjs --check",
    "docs:build-pdf": "npm run docs:render-mermaid && python3 documentation/pdf_generator/build_docs_pdf.py",
    "lint:css": "stylelint \"static/css/**/*.css\" --ignore-pattern \"static/css/main.css\" --ignore-pattern \"static/vendor/**\" && node scripts/stylelint/check-template-left-borders.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --json --outputFile=quality/raw/javascript-tests.json && node scripts/check-js-coverage.cjs",
    "vendor:sync": "node scripts/sync_vendor_assets.mjs",
    "vendor:check-cdn": "node scripts/check_no_cdn_templates.mjs",
    "svg:shrink:osm": "node scripts/reduce_svg_bandwidth.mjs --input static/osm.svg --in-place --mode auto --display-width 16 --display-height 16 --pixel-ratio 2 --target-reduction 80",
    "lint:js": "eslint static/js tests/js scripts --no-warn-ignored"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "5.15.3",
    "bootstrap": "5.3.3",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jscpd": "^4.3.0",
    "leaflet": "1.9.4",
    "mathjax": "3.2.2",
    "mermaid": "10.9.8",
    "puppeteer-core": "25.11.0",
    "stylelint": "^16.26.1",
    "svgo": "^4.0.1"
  },
  "jest": {
    "testEnvironment": "<rootDir>/tests/js/strict-environment.cjs",
    "roots": [
      "<rootDir>/tests/js",
      "<rootDir>/static/js"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/js/setup.js"
    ],
    "collectCoverageFrom": [
      "static/js/**/*.js"
    ],
    "coverageDirectory": "quality/raw",
    "verbose": true,
    "coverageReporters": [
      [
        "json",
        {
          "file": "javascript-coverage.json"
        }
      ],
      "text-summary",
      "lcovonly"
    ]
  }
}
