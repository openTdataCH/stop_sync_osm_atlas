    {
      "pattern": "documentation/generated/**",
      "reason": "Generated documentation"
    },
    {
      "pattern": "quality/raw/**",
      "reason": "Generated analyzer evidence"
    },
    {
      "pattern": "quality/latest.json",
      "reason": "Generated quality artifact"
    },
    {
      "pattern": "quality/quality-map.json",
      "reason": "Generated graph"
    },
    {
      "pattern": "quality/report.md",
      "reason": "Generated report"
