    {
      "pattern": "tests/**",
      "reason": "Tests and fixtures have evidence associations, not production coverage ownership"
    },
    {
      "pattern": "node_modules/**",
      "reason": "Installed dependencies"
    },
    {
      "pattern": ".venv/**",
      "reason": "Installed Python dependencies"
    },
    {
      "pattern": "data/**",
      "reason": "Runtime data"
    },
    {
      "pattern": "mutants/**",
      "reason": "Generated mutation worktree"
