{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["schema_version", "revision", "fingerprints", "generated_at", "completeness", "checks", "modules", "artifacts", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "object", "required": ["app", "engine"], "additionalProperties": {"type": ["string", "null"]}},
    "fingerprints": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "generated_at": {"type": "string"}, "completeness": {"enum": ["complete", "partial", "stale", "unavailable"]},
    "tools": {"type": "object"}, "checks": {"type": "array"}, "artifacts": {"type": "array", "items": {"type": "string"}},
    "modules": {"type": "object", "additionalProperties": {"type": "object", "required": ["criticality", "tests", "coverage", "mutation", "duplication", "dead_code", "docs", "architecture", "exceptions"], "properties": {
      "criticality": {"enum": ["critical", "high", "medium", "low"]},
      "tests": {"$ref": "#/$defs/measurement"}, "coverage": {"$ref": "#/$defs/measurement"}, "mutation": {"$ref": "#/$defs/measurement"}, "duplication": {"$ref": "#/$defs/measurement"}, "dead_code": {"$ref": "#/$defs/measurement"}, "docs": {"$ref": "#/$defs/measurement"}, "architecture": {"$ref": "#/$defs/measurement"}, "security": {"$ref": "#/$defs/measurement"}, "changed_coverage": {"$ref": "#/$defs/measurement"}, "trend": {"$ref": "#/$defs/measurement"}, "exceptions": {"type": "array"}
    }, "additionalProperties": false}}
  }, "additionalProperties": false,
  "$defs": {"measurement": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pass", "fail", "attention", "measured", "not_measured", "stale", "not_applicable", "invalid"]}}, "additionalProperties": true}}
}
