{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "repository", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"enum": ["app", "engine"]},
    "source_roots": {"$ref": "#/$defs/strings"},
    "source_files": {"$ref": "#/$defs/strings"},
    "exclusions": {"type": "array", "items": {"type": "object", "required": ["pattern", "reason"], "properties": {"pattern": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
    "contracts": {"type": "array", "items": {"type": "object", "required": ["id", "producers", "consumers", "tests", "docs"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "producers": {"$ref": "#/$defs/strings"}, "consumers": {"$ref": "#/$defs/strings"}, "tests": {"$ref": "#/$defs/strings"}, "docs": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "module": {
      "type": "object", "required": ["id", "title", "criticality", "responsibility", "owner", "reviewed", "paths", "invariants", "docs", "entrypoints"],
      "properties": {
        "id": {"type": "string", "pattern": "^(app|engine|platform)\\.[a-z-]+$"},
        "title": {"type": "string", "minLength": 1}, "responsibility": {"type": "string", "minLength": 1},
        "criticality": {"enum": ["critical", "high", "medium", "low"]},
        "owner": {"type": "string", "minLength": 1}, "reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "paths": {"type": "object", "required": ["source", "tests"], "properties": {"source": {"$ref": "#/$defs/strings"}, "tests": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
        "invariants": {"$ref": "#/$defs/strings"}, "entrypoints": {"$ref": "#/$defs/strings"}, "dependencies": {"$ref": "#/$defs/strings"},
        "contracts": {"type": "object", "properties": {"produces": {"$ref": "#/$defs/strings"}, "consumes": {"$ref": "#/$defs/strings"}, "database": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
        "docs": {"type": "object", "properties": {"explanation": {"$ref": "#/$defs/strings"}, "reference": {"$ref": "#/$defs/strings"}, "operations": {"$ref": "#/$defs/strings"}, "decision": {"$ref": "#/$defs/strings"}, "howto": {"$ref": "#/$defs/strings"}}, "additionalProperties": false}
      }, "additionalProperties": false
    }
  }
}
